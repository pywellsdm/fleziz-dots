@import "matugen.rasi"

* {
    font: "Figtree 13";
    g-spacing: 10px;
    g-margin: 0;
    b-radius: 8px;
    g-padding: 8px;
}

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
}

listview {
    columns: 1;
    lines: 7;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    border: 0px solid;
}

window {
    transparency: "real";
    width: 450px;
    border-radius: @b-radius;
    background-color: #000000CC;
    border: 2px solid;
    border-color: @outline-variant;
    padding: @g-padding;
}

prompt {
    text-color: @primary;
}

inputbar {
    children: ["prompt", "entry"];
    spacing: @g-spacing;
}

entry {
    placeholder: "Search Apps";
    text-color: @on-surface;
    placeholder-color: @on-surface-variant;
}

mainbox {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    children: ["inputbar", "listview", "message"];
}

element {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    border: 0px solid;
    border-radius: @b-radius;
    background-color: transparent;
    text-color: @on-surface;
}

element normal.normal {
    background-color: transparent;
    text-color: @on-surface;
}

element alternate.normal {
    background-color: #11111188;
    text-color: @on-surface;
}

element selected.active {
    background-color: @primary;
    text-color: @on-primary;
}

element selected.normal {
    background-color: @primary;
    text-color: @on-primary;
}

message {
    background-color: #00000088;
    border: 0px solid;
}
