{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "color": {
            "1": "#c1c1c5"
        },
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ❯  ",
        "color": {
            "keys": "#c1c1c5",
            "title": "#c1c1c5"
        },
        "key": {
            "width": 14
        }
    },
    "modules": [
        "title",
        {
            "type": "separator",
            "string": "─────────────────────────"
        },
        "break",
        {
            "type": "os",
            "key": " 󰣇  OS       ",
            "keyColor": "#c1c1c5"
        },
        {
            "type": "kernel",
            "key": " 󰡳  KERNEL   ",
            "keyColor": "#CCCBCC"
        },
        {
            "type": "host",
            "key": " 󰌢  HOST     ",
            "keyColor": "#C0BEC0"
        },
        {
            "type": "shell",
            "key": " 󱆃  SHELL    ",
            "keyColor": "#c1c1c5"
        },
        {
            "type": "terminal",
            "key": " 󰆍  TERM     ",
            "keyColor": "#A79F9D"
        },
        {
            "type": "separator",
            "string": "─────────────────────────"
        },
        {
            "type": "cpu",
            "key": " 󰻠  CPU      ",
            "keyColor": "#7F7E80"
        },
        {
            "type": "gpu",
            "key": " 󰍛  GPU      ",
            "keyColor": "#CCCBCC"
        },
        {
            "type": "memory",
            "key": " 󰑭  RAM      ",
            "keyColor": "#c1c1c5"
        },
        {
            "type": "disk",
            "key": " 󰋊  DISK     ",
            "keyColor": "#A79F9D"
        },
        {
            "type": "uptime",
            "key": " 󱎫  UPTIME   ",
            "keyColor": "#C0BEC0"
        },
        {
            "type": "datetime",
            "key": " 󰃰  DATE     ",
            "keyColor": "#c1c1c5"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
